{
  "name": "bodyforge-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4174",
    "build": "next build",
    "start": "npx serve out -l 4173",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "typescript": "^6.0.3"
  },
  "//browserslist": "styles.css states every colour in oklch with no sRGB fallback, so the site already requires browsers that support it. Without this the CSS minifier downlevels the whole palette to sRGB hex and the ember clamps out of wide gamut.",
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 113",
    "safari >= 15.4",
    "ios_saf >= 15.4"
  ]
}
